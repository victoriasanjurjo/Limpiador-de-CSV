{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Limpiador de CSV",
  "version": "1.0.0",
  "identifier": "com.victoriasanjurjo.limpiadordecsv",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Limpiador de CSV — Victoria Sanjurjo",
        "width": 1220,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CN=CF220D35-0C1C-408C-BCB2-E85AA65BC95B",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

