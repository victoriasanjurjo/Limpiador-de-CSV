<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="VictoriaSanjurjo.LimpiadordeCSV"
    Publisher="CN=CF220D35-0C1C-408C-BCB2-E85AA65BC95B"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Limpiador de CSV</DisplayName>
    <PublisherDisplayName>Victoria Sanjurjo</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Utilidad para Windows que limpia, normaliza y ordena archivos CSV con un solo clic, mostrando una vista comparativa doble de las 5 primeras filas.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-ES" />
  </Resources>

  <Applications>
    <Application
      Id="LimpiadorDeCSV"
      Executable="limpiador-de-csv.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Limpiador de CSV"
        Description="Limpiador y ordenador de archivos CSV con un solo clic desarrollado por Victoria Sanjurjo."
        BackgroundColor="#0D9488"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

